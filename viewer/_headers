# Cabeceras de Cloudflare Pages (visorarriendos.pages.dev).
# Scripts: solo los propios y Leaflet desde unpkg (con integridad SRI en el HTML).
# Tipografías servidas desde el propio sitio (fuentes/). Fotos: vienen de los
# portales (https). Teselas del mapa: OpenStreetMap.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://unpkg.com; style-src 'self' 'unsafe-inline' https://unpkg.com; font-src 'self'; img-src 'self' data: https:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  X-Frame-Options: DENY
  X-Robots-Tag: noindex

/fuentes/*
  Cache-Control: public, max-age=31536000, immutable
