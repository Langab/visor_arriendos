# Cabeceras de Cloudflare Pages (midepto.pages.dev).
# Scripts: solo los propios y Leaflet desde unpkg (con integridad SRI en el HTML).
# Fotos: vienen de los portales (https). Teselas del mapa: OpenStreetMap.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://unpkg.com; style-src 'self' 'unsafe-inline' https://unpkg.com https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  X-Frame-Options: DENY
  X-Robots-Tag: noindex
